# Apiary-Journal on Apache.
#
# The bundled .htaccess files already cover api/config.php and backups/ where
# AllowOverride permits them. Putting the same rules in the virtual host means
# they hold even if AllowOverride is off, which is both faster and safer.
# Adjust ServerName, the paths and the certificates.

<VirtualHost *:443>
    ServerName   apiary.example.org
    DocumentRoot /var/www/apiary-journal

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/apiary.example.org/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/apiary.example.org/privkey.pem

    <Directory /var/www/apiary-journal>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.html
    </Directory>

    # The database password lives in this file.
    <Files "config.php">
        Require all denied
    </Files>

    # Snapshots hold every record including password hashes; they are served by
    # the API after a role check, never as static files. The rest is the
    # schema, the docs, the tests, these samples and the git hooks.
    <DirectoryMatch "/var/www/apiary-journal/(backups|db|docs|tests|deploy|\.githooks)">
        Require all denied
    </DirectoryMatch>

    # Hidden files: .git, .env, editor leftovers.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # Uncomment once setup is done, as a second line of defence should you
    # forget to delete the file.
    # <Files "install.php">
    #     Require all denied
    # </Files>

    # index.html carries its own Content-Security-Policy; frame-ancestors and
    # HSTS cannot be set from a meta tag, so they are added here.
    Header always set X-Frame-Options        "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy        "same-origin"
    Header always set Content-Security-Policy "frame-ancestors 'none'"

    # Only switch this on once the site really is HTTPS-only: browsers
    # remember it for a year, for this host and all its subdomains.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</VirtualHost>

# Plain HTTP exists only to send visitors to HTTPS.
<VirtualHost *:80>
    ServerName apiary.example.org
    Redirect permanent / https://apiary.example.org/
</VirtualHost>
